DATABASE_URL=postgresql+psycopg://so2check:CHANGE_ME@127.0.0.1/so2check
BOT_TOKEN=
BOT_USERNAME=so2_check_bot
PUBLIC_URL=https://YOUR_DOMAIN
ALLOWED_ORIGINS=https://YOUR_GITHUB_ACCOUNT.github.io
AUTH_MAX_AGE=300
SESSION_TTL=43200
REFRESH_TTL=300
SOURCE_TIMEOUT=30
SOURCE_MIN_INTERVAL=2
HISTORY_MAX_PAGES=10
SOURCE_ADAPTER=
# Android collector: device secrets are provisioned into the DB, never here.
COLLECTOR_ENABLED=false
COLLECTOR_SCHEDULE_ENABLED=false
COLLECTOR_STORAGE=/var/lib/so2-check/collector
COLLECTOR_MAX_STORAGE_MB=512
COLLECTOR_PILOT_UID=202777998
COLLECTOR_LEASE_SECONDS=1800
MANUAL_IMPORT_ENABLED=true
